# Drama Radar — the only required setting
#
# Copy to .env for local use:  cp .env.example .env
# On Vercel: Project -> Settings -> Environment Variables -> add this one key.
#
# Without it the app still runs, in demo mode with a bundled batch.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- all optional, sensible defaults shown ---
# Leave the model empty to auto-pick the best FREE model (re-ranked every 6h).
# DRAMA_RADAR_MODEL=

# Wall-clock budget for one scrape. Must stay under Vercel's maxDuration (60s).
# DRAMA_RADAR_BUDGET_MS=52000

# How long the feed-fetch phase may run before using whatever answered.
# DRAMA_RADAR_DEADLINE_MS=20000

# Ports for `npm run dev` / `npm run serve`.
# API_PORT=8787
# WEB_PORT=5173
